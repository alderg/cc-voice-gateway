#!/bin/sh
# git credential helper for github.com: the token from the mounted secrets, if
# there is one. Without it, git works anonymously: public repositories only.
[ "${1:-}" = get ] || exit 0
cat >/dev/null
file="${VOICE_SECRETS:-/run/secrets/voice}/github_token"
[ -s "$file" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$file")"
