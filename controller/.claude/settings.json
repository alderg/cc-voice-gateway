{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__voice__reply",
      "mcp__voice__list_workers",
      "mcp__voice__dispatch",
      "mcp__voice__worker_status",
      "mcp__voice__stop_worker",
      "mcp__voice__open_items",
      "mcp__voice__resolve_decision",
      "mcp__voice__restart_controller",
      "mcp__voice__raise_alarm",
      "mcp__voice__clone_repo",
      "mcp__voice__delete_path",
      "mcp__plugin_voice_voice__reply",
      "mcp__plugin_voice_voice__list_workers",
      "mcp__plugin_voice_voice__dispatch",
      "mcp__plugin_voice_voice__worker_status",
      "mcp__plugin_voice_voice__stop_worker",
      "mcp__plugin_voice_voice__open_items",
      "mcp__plugin_voice_voice__resolve_decision",
      "mcp__plugin_voice_voice__restart_controller",
      "mcp__plugin_voice_voice__raise_alarm",
      "mcp__plugin_voice_voice__clone_repo",
      "mcp__plugin_voice_voice__delete_path",
      "Bash",
      "Write",
      "Edit",
      "NotebookEdit"
    ],
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/confine.mjs\" || exit 2"
          }
        ]
      }
    ]
  }
}
